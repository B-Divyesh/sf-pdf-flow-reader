{
  "name": "pdf-flow-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs && cp staticwebapp.config.json dist/",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "assets": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.4",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
